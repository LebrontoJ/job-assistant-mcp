# Which model backend the agent host uses: gemini | anthropic
LLM_PROVIDER=gemini
# Model id for LLM_PROVIDER. Gemini: check https://ai.google.dev/gemini-api/docs/models for ids and free-tier access.
# Anthropic default when empty: claude-opus-5-5
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# Anthropic: leave the key empty if you use `ant auth login`; the SDK resolves credentials itself.
ANTHROPIC_API_KEY=
# low | medium | high | xhigh | max (empty = model default)
LLM_EFFORT=
# Server-side refusal fallback is on for Anthropic; set to "off" on Bedrock/Vertex/Foundry.
LLM_FALLBACK=

# Eval judge, if it should differ from the agent. The judge model is never inherited across providers.
JUDGE_PROVIDER=
JUDGE_MODEL=

# Dense retrieval backend: none | local (local is not implemented yet)
EMBEDDINGS=none

# Data locations (defaults point at the synthetic sample data).
PROFILE_DIR=data/sample/profile
APPLICATIONS_FILE=data/sample/applications.json
