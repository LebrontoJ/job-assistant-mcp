# Which model backend the agent host and (optionally) the eval judge use.
LLM_PROVIDER=gemini
# Check https://ai.google.dev/gemini-api/docs/models for current model IDs and free-tier access.
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# Used once the Anthropic adapter exists.
ANTHROPIC_API_KEY=

# Data locations (defaults point at the synthetic sample data).
PROFILE_DIR=data/sample/profile
APPLICATIONS_FILE=data/sample/applications.json
