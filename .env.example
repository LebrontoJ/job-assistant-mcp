# Which model backend the agent host uses: gemini | anthropic
LLM_PROVIDER=gemini
# Model id for LLM_PROVIDER. Gemini: check https://ai.google.dev/gemini-api/docs/models for ids and free-tier access.
# Anthropic default when empty: claude-opus-5-5
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# Anthropic: leave the key empty if you use `ant auth login`; the SDK resolves credentials itself.
ANTHROPIC_API_KEY=
# low | medium | high | xhigh | max (empty = model default)
LLM_EFFORT=
# Server-side refusal fallback is on for Anthropic; set to "off" on Bedrock/Vertex/Foundry.
LLM_FALLBACK=

# Eval judge, if it should differ from the agent. The judge model is never inherited across providers.
# A different, similarly sized model avoids a model grading its own mistakes without eating the agent's quota,
# e.g. JUDGE_MODEL=gemini-3.5-flash-lite while LLM_MODEL=gemini-3.1-flash-lite (quota is per model).
JUDGE_PROVIDER=
JUDGE_MODEL=

# Dense retrieval backend: none | gemini | local (local is not implemented yet). gemini sends profile text to Google.
EMBEDDINGS=none
# gemini-embedding-001 (default) or gemini-embedding-2; 768 dims by default. Non-default settings get no similarity floor.
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
# Overrides the built-in floor (0.55 for the default model)
EMBEDDING_MIN_SIM=
# match_resume's embedding thresholds (defaults 0.75 / 0.65 for the default model, set both to override)
EMBEDDING_MATCH_HIGH=
EMBEDDING_MATCH_LOW=

# Data locations (defaults point at the synthetic sample data).
PROFILE_DIR=data/sample/profile
APPLICATIONS_FILE=data/sample/applications.json
