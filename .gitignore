node_modules
dist
.env
.env.*
!.env.example
# real personal data never goes in the repo; only data/sample (synthetic) is tracked
data/profile/
# Personal source manifests, unresolved facts and eval cases/results stay outside the index.
data/private-profile/
data/applications.json
.cache/
evals/results/*
!evals/results/.gitkeep
*.log
.DS_Store
# agent traces may contain profile text
.traces/
# Transactional tracker and SQLite journals (may contain personal data)
*.sqlite
*.sqlite-wal
*.sqlite-shm
